# Localhost only — copy to .env and change secrets before any real use.
PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# Long random strings. Generate new ones: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_dev_only_replace_with_64_plus_chars
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_dev_only_replace_with_64_plus_chars

# Peppers for redeem-code / HWID hashing. Set these once and NEVER change them:
# rotating them invalidates every unredeemed code and every HWID binding.
# If left blank they fall back to JWT_ACCESS_SECRET (legacy behaviour).
CODE_PEPPER=
HWID_PEPPER=
# HMAC key for short-lived bootstrap tickets and product leases.
PROTECTION_PEPPER=
# ECDSA P-256 PEM keypair used to sign runtime packages. Required in production.
RUNTIME_PACKAGE_PRIVATE_KEY=
RUNTIME_PACKAGE_PUBLIC_KEY=

# Set to 1 (or "loopback"/"uniquelocal") ONLY when running behind a reverse proxy.
# When empty, X-Forwarded-For is ignored so clients can't spoof their IP.
TRUST_PROXY=

# Access token short-lived; refresh longer (stored hashed in DB so it can be revoked)
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=604800

# Bootstrap admin (seed script). Change password after first login.
ADMIN_EMAIL=admin@oak.local
ADMIN_PASSWORD=OakAdmin!ChangeMe
ADMIN_USERNAME=admin

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://127.0.0.1:8787,http://localhost:8787,http://127.0.0.1:3000,http://localhost:3000

# Password reset emails (optional — without SMTP, links are printed to API console)
PUBLIC_SITE_URL=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8787
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Oak <noreply@oak.local>

# SQLite file (created automatically)
DATABASE_PATH=./data/oak.sqlite

# Internal fulfill tooling (admin / migration). Provider webhooks use their own secrets.
FULFILL_SECRET=CHANGE_ME_fulfill_secret_long_random

# Payments — see oak/docs/payments.md (NOWPayments only: crypto + card/fiat)
# Dev defaults to mock checkout when NOWPayments keys are unset.
PAYMENT_MOCK=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_CALLBACK_URL=

# Cloudflare Turnstile secret. Required in production (fail-closed if missing).
# Leave blank only for local development.
TURNSTILE_SECRET=
# Name of the refresh-token cookie issued to browsers.
SESSION_COOKIE_NAME=oak_rt
# Set only when the site and API sit on different subdomains, e.g. .oak.gg
SESSION_COOKIE_DOMAIN=
ADMIN_COOKIE_NAME=oak_admin_at

# PAYMENT_MOCK is ignored when NODE_ENV=production (mock checkout cannot mint licenses live).
