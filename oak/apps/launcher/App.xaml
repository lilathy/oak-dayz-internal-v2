<Application x:Class="OakLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#050505"/>
    <SolidColorBrush x:Key="Panel" Color="#121212"/>
    <SolidColorBrush x:Key="Bar" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="Line" Color="#282828"/>
    <SolidColorBrush x:Key="LineHi" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Txt" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="TxtMid" Color="#909090"/>
    <SolidColorBrush x:Key="TxtDim" Color="#5C5C5C"/>
    <SolidColorBrush x:Key="Acc" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ok" Color="#8FCB8F"/>
    <SolidColorBrush x:Key="Warn" Color="#D8BE7C"/>
    <SolidColorBrush x:Key="Bad" Color="#D69185"/>
    <SolidColorBrush x:Key="Btn" Color="#1F1F1F"/>
    <SolidColorBrush x:Key="BtnHover" Color="#2C2C2C"/>

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource Bg}"/>
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="#0A0A0A"/>
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Acc}"/>
    </Style>

    <Style x:Key="Pwd" TargetType="PasswordBox">
      <Setter Property="Background" Value="#0A0A0A"/>
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource Acc}"/>
    </Style>

    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Acc}"/>
      <Setter Property="Foreground" Value="#050505"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostBtn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Btn}"/>
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource BtnHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Micro" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TxtDim}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TxtMid}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="3"/>
      <Setter Property="Background" Value="#0A0A0A"/>
      <Setter Property="Foreground" Value="{StaticResource Acc}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Background" Value="{StaticResource Bar}"/>
      <Setter Property="Foreground" Value="{StaticResource Txt}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    </Style>
  </Application.Resources>
</Application>
