<Window x:Class="OakLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Oak Launcher"
        Height="680" Width="1000"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

  <Grid>
    <!-- BOOT -->
    <StackPanel x:Name="BootView" HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="OAK" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"
                 Foreground="{StaticResource Acc}"/>
      <TextBlock x:Name="BootStatus" Text="Connecting…" Margin="0,10,0,0" HorizontalAlignment="Center"
                 Foreground="{StaticResource TxtMid}" FontSize="12"/>
      <ProgressBar IsIndeterminate="True" Width="180" Margin="0,16,0,0"/>
    </StackPanel>

    <!-- LOGIN -->
    <Border x:Name="LoginView" Visibility="Collapsed"
            Width="380" HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="28">
      <StackPanel>
        <TextBlock Text="OAK" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Acc}"/>
        <TextBlock Text="Launcher" Margin="0,2,0,18" Foreground="{StaticResource TxtMid}" FontSize="12"/>

        <TextBlock Text="USERNAME / EMAIL" Style="{StaticResource Micro}" Margin="0,0,0,6"/>
        <TextBox x:Name="LoginBox" Style="{StaticResource Field}" Margin="0,0,0,12"
                 KeyDown="LoginField_KeyDown"/>

        <TextBlock Text="PASSWORD" Style="{StaticResource Micro}" Margin="0,0,0,6"/>
        <PasswordBox x:Name="PasswordBox" Style="{StaticResource Pwd}" Margin="0,0,0,14"
                     KeyDown="LoginField_KeyDown"/>

        <CheckBox x:Name="RememberBox" Content="Stay signed in on this PC" IsChecked="True" Margin="0,0,0,16"/>

        <Button x:Name="LoginBtn" Content="Sign in" Style="{StaticResource PrimaryBtn}" Click="Login_Click"/>
        <TextBlock x:Name="LoginError" Margin="0,12,0,0" Foreground="{StaticResource Bad}"
                   TextWrapping="Wrap" FontSize="12"/>

        <Border Margin="0,18,0,0" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
          <StackPanel>
            <TextBlock x:Name="LoginApiLine" Foreground="{StaticResource TxtDim}" FontSize="11"/>
            <TextBlock x:Name="LoginHwidLine" Foreground="{StaticResource TxtDim}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- APP SHELL -->
    <Grid x:Name="AppView" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="{StaticResource Bar}" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1" Padding="16,14">
            <StackPanel>
              <TextBlock Text="OAK" FontWeight="Bold" FontSize="14"/>
              <TextBlock x:Name="SidebarUser" Foreground="{StaticResource TxtMid}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <StackPanel DockPanel.Dock="Bottom" Margin="12">
            <TextBlock x:Name="SidebarVersion" Style="{StaticResource Micro}" Margin="2,0,0,8"/>
            <Button Content="Sign out" Style="{StaticResource GhostBtn}" Click="Logout_Click"/>
          </StackPanel>

          <StackPanel Margin="10,16,10,10">
            <TextBlock Text="PRODUCTS" Style="{StaticResource Micro}" Margin="6,0,0,8"/>
            <ListBox x:Name="ProductList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource Txt}" SelectionChanged="ProductList_SelectionChanged">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="10,9"/>
                  <Setter Property="Margin" Value="0,0,0,4"/>
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1FFFFFFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Detail -->
      <Grid Grid.Column="1" Margin="28,24,28,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock x:Name="ProductTitle" Text="Select a product" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock x:Name="ProductDesc" Margin="0,6,0,0" Foreground="{StaticResource TxtMid}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Blocking notice -->
        <Border x:Name="NoticeBar" Grid.Row="1" Visibility="Collapsed" Margin="0,18,0,0"
                Background="#1A1512" BorderBrush="{StaticResource Warn}" BorderThickness="1,0,0,0" Padding="14,10">
          <TextBlock x:Name="NoticeText" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12"/>
        </Border>

        <!-- Status cards -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,18,0,0">
          <Border Margin="0,0,8,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <StackPanel>
              <TextBlock Text="PRODUCT" Style="{StaticResource Micro}"/>
              <TextBlock x:Name="StatProductStatus" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Margin="0,0,8,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <StackPanel>
              <TextBlock Text="CLIENT VERSION" Style="{StaticResource Micro}"/>
              <TextBlock x:Name="StatVersion" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                         FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Margin="0,0,8,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <StackPanel>
              <TextBlock Text="LICENSE" Style="{StaticResource Micro}"/>
              <TextBlock x:Name="StatLicense" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Margin="0,0,8,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <StackPanel>
              <TextBlock Text="TIME LEFT" Style="{StaticResource Micro}"/>
              <TextBlock x:Name="StatTimeLeft" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                         FontFamily="Consolas"/>
            </StackPanel>
          </Border>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <StackPanel>
              <TextBlock Text="GAME" Style="{StaticResource Micro}"/>
              <TextBlock x:Name="StatGame" Text="—" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Grid.Row="3" Margin="0,16,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" Padding="16">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="DETAILS" Style="{StaticResource Micro}" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Plan" Foreground="{StaticResource TxtDim}"/>
                <TextBlock x:Name="DetailPlan" Grid.Row="0" Grid.Column="1" FontFamily="Consolas"/>

                <TextBlock Grid.Row="1" Text="Expires" Foreground="{StaticResource TxtDim}" Margin="0,8,0,0"/>
                <TextBlock x:Name="DetailExpires" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" FontFamily="Consolas"/>

                <TextBlock Grid.Row="2" Text="HWID" Foreground="{StaticResource TxtDim}" Margin="0,8,0,0"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" LastChildFill="False">
                  <TextBlock x:Name="DetailHwid" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="Consolas"/>
                  <Button x:Name="ResetHwidBtn" DockPanel.Dock="Left" Content="Reset" Style="{StaticResource SmallBtn}"
                          Margin="12,0,0,0" Click="ResetHwid_Click"
                          ToolTip="Unbinds this account so it can be re-bound on the next sign-in. Allowed once every 72 hours."/>
                </DockPanel>

                <TextBlock Grid.Row="3" Text="Client build" Foreground="{StaticResource TxtDim}" Margin="0,8,0,0"/>
                <TextBlock x:Name="DetailBuild" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" FontFamily="Consolas"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="4" Text="Updated" Foreground="{StaticResource TxtDim}" Margin="0,8,0,0"/>
                <TextBlock x:Name="DetailUpdated" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" FontFamily="Consolas"/>

                <TextBlock Grid.Row="5" Text="Account" Foreground="{StaticResource TxtDim}" Margin="0,8,0,0"/>
                <TextBlock x:Name="DetailAccount" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0"/>

                <TextBlock Grid.Row="6" Text="Changelog" Foreground="{StaticResource TxtDim}" Margin="0,14,0,0"/>
                <TextBlock x:Name="DetailChangelog" Grid.Row="6" Grid.Column="1" Margin="0,14,0,0"
                           TextWrapping="Wrap" Foreground="{StaticResource TxtMid}"/>
              </Grid>

              <TextBlock Text="REDEEM CODE" Style="{StaticResource Micro}" Margin="0,22,0,10"/>
              <DockPanel LastChildFill="True">
                <Button x:Name="RedeemBtn" DockPanel.Dock="Right" Content="Redeem" Style="{StaticResource PrimaryBtn}"
                        Margin="10,0,0,0" MinWidth="100" Click="Redeem_Click"/>
                <TextBox x:Name="RedeemBox" Style="{StaticResource Field}"
                         KeyDown="RedeemBox_KeyDown"
                         ToolTip="OAK-XXXX-XXXX-XXXX-XXXX"/>
              </DockPanel>
              <TextBlock x:Name="RedeemStatus" Margin="0,8,0,0" Foreground="{StaticResource TxtMid}" FontSize="12"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,14,0,0">
          <CheckBox x:Name="AutoStartGameBox" Content="Start game automatically" IsChecked="True"
                    Margin="4,0,0,10" FontSize="12" Foreground="{StaticResource TxtMid}"
                    Checked="AutoStartGame_Changed" Unchecked="AutoStartGame_Changed"
                    ToolTip="On: Oak starts DayZ_BE after mapping. Off: opens DayZ Launcher only — you press Play; Oak injects when the game starts."/>
          <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,0,0,10"/>
          <DockPanel LastChildFill="True">
            <Button x:Name="LaunchBtn" DockPanel.Dock="Right" Content="Launch" Style="{StaticResource PrimaryBtn}"
                    MinWidth="140" Click="Launch_Click" IsEnabled="False"
                    ToolTip="Maps Oak, then starts the game (or waits if auto-start is off)."/>
            <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource GhostBtn}"
                    Margin="0,0,10,0" Visibility="Collapsed" Click="Cancel_Click"/>
            <TextBlock x:Name="StatusLine" VerticalAlignment="Center" Margin="4,0,12,0"
                       Foreground="{StaticResource TxtMid}" FontSize="12" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock x:Name="ProgressLabel" Margin="0,6,0,0" FontSize="11"
                     Foreground="{StaticResource TxtMid}" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
