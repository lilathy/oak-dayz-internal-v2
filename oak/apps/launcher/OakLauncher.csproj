<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OakLauncher</AssemblyName>
    <RootNamespace>OakLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Oak Launcher</Product>
    <Company>Oak</Company>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The C++ loader lives in this folder but is built by MSVC, not the SDK. -->
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="oak.launcher.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('oak.launcher.json')" />
  </ItemGroup>

  <!-- Keep local tooling (CacheSmoke, etc.) out of the WPF launcher build. -->
  <ItemGroup>
    <Compile Remove="tools\**\*" />
    <None Remove="tools\**\*" />
    <EmbeddedResource Remove="tools\**\*" />
    <Page Remove="tools\**\*" />
  </ItemGroup>

  <!-- Expose internals to the launch smoke harness. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LaunchSmoke" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
